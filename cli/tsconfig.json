{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@airprompter/agent-sdk": [
        "../sdk-typescript/packages/sdk/src/index.ts"
      ],
      "@airprompter/agent-sdk/core": [
        "../sdk-typescript/packages/sdk/src/core/index.ts"
      ],
      "@airprompter/agent-sdk/sync": [
        "../sdk-typescript/packages/sdk/src/sync/index.ts"
      ],
      "@airprompter/agent-sdk/runtime": [
        "../sdk-typescript/packages/sdk/src/runtime/index.ts"
      ],
      "@airprompter/agent-sdk/telemetry": [
        "../sdk-typescript/packages/sdk/src/telemetry/index.ts"
      ],
      "@airprompter/agent-sdk/testing": [
        "../sdk-typescript/packages/sdk/src/testing.ts"
      ],
      "@airprompter/agent-otel/exporter": [
        "../sdk-typescript/packages/agent-otel/src/exporter/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../sdk-typescript/packages/*/src/**/*.ts",
    "../sdk-typescript/test/helpers/*.ts"
  ],
  "exclude": [
    "../sdk-typescript/packages/datastore-*/**",
    "../sdk-typescript/packages/sdk/src/frameworks/**"
  ]
}
