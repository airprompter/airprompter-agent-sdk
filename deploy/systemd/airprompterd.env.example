# /etc/airprompter/airprompterd.env — mode 0600, owned by the daemon's user.
# The Agent key (distribution kind) from the Agent's Settings tab. Never on argv.
AIRPROMPTER_AGENT_KEY=apa_live_…
AIRPROMPTER_ORG=org_…
AIRPROMPTER_AGENT=agt_…
AIRPROMPTER_ENVIRONMENT=prod
# From the environment's heartbeat / Settings tab.
AIRPROMPTER_ROOT_URL=https://<edge>/roots/prod/root.json
AIRPROMPTER_EDGE_POINTER_URL=https://<edge>/g/<token>/generation.json
