# /etc/airprompter/airprompterd.env — mode 0600, owned by the daemon's user.
# The Agent key (distribution kind) from the Agent's Settings tab: the daemon uses it only to obtain upload grants.
# Never on argv. With --upload-sink otlp the daemon needs no key at all.
AIRPROMPTER_AGENT_KEY=apa_live_…
AIRPROMPTER_ORG=org_…
AIRPROMPTER_AGENT=agt_…
AIRPROMPTER_ENVIRONMENT=prod
