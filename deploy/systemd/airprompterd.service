# airprompterd as a systemd service: the host's telemetry daemon. It ships
# the spool that SDK processes on this host write (to AirPrompter, or with
# --upload-sink otlp to your collector) and does nothing else — no release,
# no store, no socket (protocol/daemon.md).
#
#   install -m 0755 airprompter-linux-x64 /usr/local/bin/airprompter
#   install -d -o airprompter -g airprompter -m 0700 /var/lib/airprompter
#   install -m 0600 -o airprompter airprompterd.env /etc/airprompter/airprompterd.env   # AIRPROMPTER_AGENT_KEY=…
#   systemctl enable --now airprompterd
#
# It publishes /var/lib/airprompter/airprompter/<agent>/<env>/daemon.json
# naming the folder it scans. Application processes that run as the same
# user with the same state directory (XDG_STATE_HOME=/var/lib/airprompter)
# find it, write their segments there with a manifest each, and leave the
# upload to it; their release still comes from their own store, the
# datastore or a vendored bundle. The daemon is never a hard requirement: a
# process with a key uploads its own spool when the daemon is not there.

[Unit]
Description=AirPrompter telemetry daemon (airprompterd)
Documentation=https://github.com/airprompter/airprompter-agent-sdk/blob/main/protocol/daemon.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airprompter
Group=airprompter
EnvironmentFile=/etc/airprompter/airprompterd.env
Environment=XDG_STATE_HOME=/var/lib/airprompter
ExecStart=/usr/local/bin/airprompter daemon \
  --org ${AIRPROMPTER_ORG} \
  --agent ${AIRPROMPTER_AGENT} \
  --environment ${AIRPROMPTER_ENVIRONMENT} \
  --json
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening: the daemon needs its state directory, outbound HTTPS, and nothing else.
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airprompter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
