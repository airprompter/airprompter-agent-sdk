{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airprompter.com/protocol/spool-rows/1",
  "title": "Spool segment rows",
  "description": "Every line of a spool segment is one of these. `window` is telemetry-window/1; `step`, `refusal` and `dropped` are defined here. A step is its own row type, never a window, so no fold over windows can count one. A reader skips and counts an unknown row type or version, and strips an unknown field; only corruption quarantines a segment (spool-format.md › Readers). No row has a field that can carry prompt text, model output or an end-user identifier.",
  "oneOf": [
    {
      "$ref": "https://airprompter.com/protocol/telemetry-window/1"
    },
    {
      "$ref": "#/$defs/step"
    },
    {
      "$ref": "#/$defs/refusal"
    },
    {
      "$ref": "#/$defs/dropped"
    }
  ],
  "$defs": {
    "instanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{8,64}$"
    },
    "step": {
      "description": "One step of a run in one minute. No count, no moments, no outcomes, no checks. `latencyMs` holds each model call's latency, so its bucket total equals `modelCalls`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "v",
        "artifactId",
        "minute",
        "instanceId",
        "instanceClass",
        "tag",
        "versionId",
        "arm",
        "model",
        "step",
        "status",
        "usageSource",
        "modelCalls",
        "latencyMs",
        "tokens",
        "tools"
      ],
      "properties": {
        "type": {
          "const": "step"
        },
        "v": {
          "const": 1
        },
        "artifactId": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/artifactId"
        },
        "minute": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/minute"
        },
        "instanceClass": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/instanceClass"
        },
        "tag": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/tag"
        },
        "versionId": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/versionId"
        },
        "arm": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/arm"
        },
        "model": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/model"
        },
        "errorClass": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/errorClass"
        },
        "usageSource": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/usageSource"
        },
        "modelCalls": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/modelCalls"
        },
        "tools": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/tools"
        },
        "latencyMs": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/latencyMs"
        },
        "tokens": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/tokens"
        },
        "sdk": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/sdk"
        },
        "audienceIds": {
          "$ref": "https://airprompter.com/protocol/telemetry-window/1#/properties/audienceIds"
        },
        "instanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "step": {
          "description": "An opaque name: a `<slotTag>#<ordinal>` step id, or a framework node or agent name. No framework concept reaches the wire. A name past STEP_BOUNDS is written as `other`.",
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,64}$"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "v",
        "at",
        "instanceId",
        "reason",
        "generation",
        "tag"
      ],
      "properties": {
        "type": {
          "const": "refusal"
        },
        "v": {
          "const": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "instanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "reason": {
          "enum": [
            "disabled",
            "lease_expired",
            "payload_verification_failed",
            "forced_downgrade",
            "model_unavailable",
            "unlock_refused"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "tag": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "maxLength": 128
            }
          ]
        }
      }
    },
    "dropped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "v",
        "at",
        "instanceId",
        "segments",
        "bytes"
      ],
      "properties": {
        "type": {
          "const": "dropped"
        },
        "v": {
          "const": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "instanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 1,
          "description": "Lines a reader skipped from a later writer. `segments` then stays 0: a line is not a segment."
        }
      }
    }
  }
}
