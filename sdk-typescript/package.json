{
  "name": "@airprompter/agent-sdk-workspace",
  "version": "0.3.0",
  "private": true,
  "description": "Workspace for the AirPrompter agent SDK packages (core, sync, runtime, telemetry, sdk) — one version, released in lockstep.",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:imports": "node scripts/lint-imports.mjs",
    "test": "npm run lint:imports && node --import tsx --test \"test/**/*.test.ts\"",
    "size": "node scripts/size-budget.mjs",
    "compat-table": "node scripts/compat-table.mjs",
    "test:wrap-live": "WRAP_LIVE=1 node --import tsx --test test/wrapLive.test.ts",
    "version:lockstep": "node scripts/version-lockstep.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "redis": "^4.7.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
