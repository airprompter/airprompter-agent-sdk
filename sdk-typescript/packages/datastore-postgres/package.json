{
  "name": "@airprompter/datastore-postgres",
  "version": "0.4.0",
  "description": "The AirPrompter release datastore over one PostgreSQL table: a KvStore with INSERT … ON CONFLICT and versioned UPDATEs, for kvReleaseDatastore. Bring your own driver (pg, Neon, anything with query(text, values)).",
  "keywords": [
    "airprompter",
    "prompts",
    "llm",
    "agent",
    "datastore",
    "postgres",
    "postgresql"
  ],
  "homepage": "https://github.com/airprompter/airprompter-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/airprompter/airprompter-agent-sdk/issues"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/airprompter/airprompter-agent-sdk",
    "directory": "sdk-typescript/packages/datastore-postgres"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\""
  },
  "airprompter": {
    "sizeBudgetBytes": 30000
  },
  "dependencies": {
    "@airprompter/agent-sync": "0.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
