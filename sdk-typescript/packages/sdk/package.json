{
  "name": "@airprompter/agent-sdk",
  "version": "1.0.0-rc.5",
  "description": "Run prompts and workflows approved in AirPrompter on your own systems: signed pull-only updates, an encrypted restart-safe slot store, offline operation, content-free telemetry. One package: the agent at the root, its parts behind the subpaths /core, /sync, /runtime and /telemetry, the CI kit at /testing, framework adapters under /frameworks on the contract at /frameworks/contract (/frameworks/openai, /frameworks/anthropic, /frameworks/ai-sdk, /frameworks/langchain; /frameworks/steps: no-code automation steps, the core of the Zapier and n8n integrations).",
  "keywords": [
    "airprompter",
    "prompts",
    "llm",
    "agent",
    "governance",
    "prompt-management",
    "openai",
    "anthropic",
    "ab-testing"
  ],
  "homepage": "https://github.com/airprompter/airprompter-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/airprompter/airprompter-agent-sdk/issues"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/airprompter/airprompter-agent-sdk",
    "directory": "sdk-typescript/packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core/public.d.ts",
        "default": "./dist/esm/core/public.js"
      },
      "require": {
        "types": "./dist/cjs/core/public.d.ts",
        "default": "./dist/cjs/core/public.js"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/esm/sync/public.d.ts",
        "default": "./dist/esm/sync/public.js"
      },
      "require": {
        "types": "./dist/cjs/sync/public.d.ts",
        "default": "./dist/cjs/sync/public.js"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/esm/runtime/public.d.ts",
        "default": "./dist/esm/runtime/public.js"
      },
      "require": {
        "types": "./dist/cjs/runtime/public.d.ts",
        "default": "./dist/cjs/runtime/public.js"
      }
    },
    "./telemetry": {
      "import": {
        "types": "./dist/esm/telemetry/public.d.ts",
        "default": "./dist/esm/telemetry/public.js"
      },
      "require": {
        "types": "./dist/cjs/telemetry/public.d.ts",
        "default": "./dist/cjs/telemetry/public.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    },
    "./frameworks/contract": {
      "import": {
        "types": "./dist/esm/frameworks/contract.d.ts",
        "default": "./dist/esm/frameworks/contract.js"
      },
      "require": {
        "types": "./dist/cjs/frameworks/contract.d.ts",
        "default": "./dist/cjs/frameworks/contract.js"
      }
    },
    "./frameworks/openai": {
      "import": {
        "types": "./dist/esm/frameworks/openai.d.ts",
        "default": "./dist/esm/frameworks/openai.js"
      },
      "require": {
        "types": "./dist/cjs/frameworks/openai.d.ts",
        "default": "./dist/cjs/frameworks/openai.js"
      }
    },
    "./frameworks/anthropic": {
      "import": {
        "types": "./dist/esm/frameworks/anthropic.d.ts",
        "default": "./dist/esm/frameworks/anthropic.js"
      },
      "require": {
        "types": "./dist/cjs/frameworks/anthropic.d.ts",
        "default": "./dist/cjs/frameworks/anthropic.js"
      }
    },
    "./frameworks/ai-sdk": {
      "import": {
        "types": "./dist/esm/frameworks/ai-sdk.d.ts",
        "default": "./dist/esm/frameworks/ai-sdk.js"
      },
      "require": {
        "types": "./dist/cjs/frameworks/ai-sdk.d.ts",
        "default": "./dist/cjs/frameworks/ai-sdk.js"
      }
    },
    "./frameworks/langchain": {
      "import": {
        "types": "./dist/esm/frameworks/langchain.d.ts",
        "default": "./dist/esm/frameworks/langchain.js"
      },
      "require": {
        "types": "./dist/cjs/frameworks/langchain.d.ts",
        "default": "./dist/cjs/frameworks/langchain.js"
      }
    },
    "./frameworks/steps": {
      "import": {
        "types": "./dist/esm/frameworks/steps/index.d.ts",
        "default": "./dist/esm/frameworks/steps/index.js"
      },
      "require": {
        "types": "./dist/cjs/frameworks/steps/index.d.ts",
        "default": "./dist/cjs/frameworks/steps/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/esm/core/public.d.ts"
      ],
      "sync": [
        "dist/esm/sync/public.d.ts"
      ],
      "runtime": [
        "dist/esm/runtime/public.d.ts"
      ],
      "telemetry": [
        "dist/esm/telemetry/public.d.ts"
      ],
      "testing": [
        "dist/esm/testing.d.ts"
      ],
      "frameworks/contract": [
        "dist/esm/frameworks/contract.d.ts"
      ],
      "frameworks/openai": [
        "dist/esm/frameworks/openai.d.ts"
      ],
      "frameworks/anthropic": [
        "dist/esm/frameworks/anthropic.d.ts"
      ],
      "frameworks/ai-sdk": [
        "dist/esm/frameworks/ai-sdk.d.ts"
      ],
      "frameworks/langchain": [
        "dist/esm/frameworks/langchain.d.ts"
      ],
      "frameworks/steps": [
        "dist/esm/frameworks/steps/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\""
  },
  "airprompter": {
    "sizeBudgetBytes": {
      ".": 285000,
      "./core": 315000,
      "./sync": 220000,
      "./runtime": 242000,
      "./telemetry": 192000,
      "./testing": 85000,
      "./frameworks/contract": 10000,
      "./frameworks/openai": 14000,
      "./frameworks/anthropic": 12000,
      "./frameworks/ai-sdk": 30000,
      "./frameworks/langchain": 30000,
      "./frameworks/steps": 100000
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.40",
    "@langchain/core": ">=1.3",
    "ai": ">=5",
    "langchain": ">=1.6",
    "openai": ">=4.50",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "langchain": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
