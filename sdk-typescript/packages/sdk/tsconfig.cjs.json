{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/cjs",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "declaration": false,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@airprompter/agent-core/testing": [
        "../core/dist/esm/testing/index.d.ts"
      ],
      "@airprompter/agent-*": [
        "../*/dist/esm/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
