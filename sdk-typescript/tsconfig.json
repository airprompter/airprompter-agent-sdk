{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@airprompter/agent-sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@airprompter/agent-sdk/core": [
        "packages/sdk/src/core/index.ts"
      ],
      "@airprompter/agent-sdk/sync": [
        "packages/sdk/src/sync/index.ts"
      ],
      "@airprompter/agent-sdk/runtime": [
        "packages/sdk/src/runtime/index.ts"
      ],
      "@airprompter/agent-sdk/telemetry": [
        "packages/sdk/src/telemetry/index.ts"
      ],
      "@airprompter/agent-sdk/testing": [
        "packages/sdk/src/testing.ts"
      ],
      "@airprompter/agent-otel/exporter": [
        "packages/agent-otel/src/exporter/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
